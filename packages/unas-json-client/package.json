{
  "name": "@storesprite/unas-json-client",
  "version": "0.1.0",
  "description": "Typed JSON client SDK for the UNAS webshop XML API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint ./src",
    "test": "vitest run src",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:watch": "vitest --watch"
  },
  "keywords": [
    "unas",
    "webshop",
    "api",
    "sdk",
    "storesprite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.9.0",
    "fast-xml-parser": "^5.2.3",
    "inversify": "^7.5.4",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.17",
    "eslint": "^9.26.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^4.0.17"
  }
}
