FROM node:24-slim

# System tooling: python3/csvkit for ultra-low-memory streaming CSV conversion,
# openssh-client/openssl/git for SFTP & source tooling, tzdata, bash. Also
# curl/gnupg/ca-certificates (needed below to add Docker's apt repo).
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv csvkit bash tzdata openssh-client openssl git \
    curl ca-certificates gnupg \
    && rm -rf /var/lib/apt/lists/*

# Docker CLI + Compose & buildx plugins from the official Docker apt repo, so
# this container can orchestrate the integration-test harness (docker build /
# buildx / compose / run) against the host daemon via /var/run/docker.sock.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin docker-buildx-plugin \
    && rm -rf /var/lib/apt/lists/*

# Set timezone
ENV TZ=Europe/Budapest
RUN ln -fs /usr/share/zoneinfo/Europe/Budapest /etc/localtime \
    && dpkg-reconfigure -f noninteractive tzdata

WORKDIR /workspace

# ---- Shared packages: install + build so their dist/ is available ----
# The processor's tsc build resolves file: deps against these built packages.
COPY packages/ /workspace/packages/
RUN cd /workspace/packages/app-config && npm install && npm run build
RUN cd /workspace/packages/mapping-rules && npm install && npm run build
RUN cd /workspace/packages/unas-json-client && npm install && npm run build

# ---- Downloader: install deps only (source is bind-mounted at runtime) ----
COPY stocksprite/downloader/ /workspace/stocksprite/downloader/
RUN cd /workspace/stocksprite/downloader && npm install

# ---- Processor: install deps only ----
COPY stocksprite/processor/ /workspace/stocksprite/processor/
RUN cd /workspace/stocksprite/processor && npm install

# Hardcoded development environment variables for the downloader
ENV USER_ID="user_3Hgss1Pn9eF6eXyIf53rKLieGJp"
ENV INTERNAL_TOKEN="mock_internal_token"
ENV BACKEND_URL="http://storesprite-be:3000"
ENV OUTPUT_DIR="/workspace/stocksprite/downloader/temp"
# When the downloader integration test runs from inside this container, the mock
# services publish ports on the Docker host; reach it via host.docker.internal.
ENV MOCK_HOST="host.docker.internal"

# Create temp output directory
RUN mkdir -p /workspace/stocksprite/downloader/temp

# Keep the container alive so `docker exec` can run commands; start no app.
CMD ["sh", "-c", "tail -f /dev/null"]
