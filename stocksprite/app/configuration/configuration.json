{
    "unasApiBase": "http://wiremock:8080/shop/",
    "redis": {
        "connection": {
            "host": "redis-stack-dev",
            "port": 6379
        }
    },
    "bullMq": {
        "queue": {
            "parsed": "parsed-data-queue",
            "translated": "translated-data-queue"
        },
        "worker": {
            "connection": {
                "host": "redis-stack-dev",
                "port": 6379
            },
            "removeOnComplete": {
                "age": 3600,
                "count": 1000
            },
            "removeOnFail": {
                "count": 100
            }
        }
    },
    "log4js": {
        "appenders": {
            "dailyLogs": {
                "type": "dateFile",
                "filename": "logs/app.log",
                "pattern": "yyyy-MM",
                "keepFileExt": true,
                "compress": false,
                "numBackups": 6,
                "layout": {
                    "type": "json-with-data-field",
                    "pattern": ""
                }
            },
            "console": {
                "type": "stdout",
                "layout": {
                    "type": "json-with-data-field",
                    "pattern": ""
                }
            }
        },
        "categories": {
            "default": {
                "appenders": ["dailyLogs", "console"],
                "level": "info"
            },
            "cache": {
                "appenders": ["dailyLogs", "console"],
                "level": "info"
            },
            "parse": {
                "appenders": ["dailyLogs", "console"],
                "level": "info"
            },
            "translate": {
                "appenders": ["dailyLogs", "console"],
                "level": "info"
            },
            "send": {
                "appenders": ["dailyLogs", "console"],
                "level": "info"
            }
        }
    }
}
