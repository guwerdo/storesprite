[
    {
        "id": "magictools-replace-spaces-in-sku-with-underscores",
        "rule": { "replace-all": [{ "var": "Cikkszám" }, " ", "_"] }
    },
    {
        "id": "depiend-stock-count-from-stock-interval",
        "rule": { "get-median": [{ "var": "Gyártói készlet" }] }
    },
    {
        "id": "magictools-expected-incoming-quantity",
        "rule": {
            "if": [
                {
                    "and": [
                        { "is-numeric": { "var": "Várható érkezés mennyiség" } },
                        { "is-date": [{ "var": "Várható érkezés dátum" }, "yyyy.MM.dd"] },
                        { "!": { "is-before-date": [{ "var": "Várható érkezés dátum" }, "yyyy.MM.dd"] } }
                    ]
                },
                {
                    "var": "Várható érkezés mennyiség"
                },
                0
            ]
        }
    },
    {
        "id": "magictools-expected-incoming-date",
        "rule": {
            "if": [
                {
                    "and": [
                        { "is-numeric": { "var": "Várható érkezés mennyiség" } },
                        { "is-date": [{ "var": "Várható érkezés dátum" }, "yyyy.MM.dd"] },
                        { "!": { "is-before-date": [{ "var": "Várható érkezés dátum" }, "yyyy.MM.dd"] } }
                    ]
                },
                {
                    "var": "Várható érkezés dátum"
                },
                ""
            ]
        }
    },
    {
        "id": "stanley-stock-multiplier",
        "rule": {
            "if": [{ "is-numeric": { "var": "stock" } }, { "*": [{ "var": "stock" }, 1000] }, 0]
        }
    }
]
