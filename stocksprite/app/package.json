{
    "name": "stocksprite",
    "version": "1.0.0",
    "main": "subscribe.js",
    "scripts": {
        "build": "npm run create-product-dto-schema && npm run create-data-source-schema && tsc",
        "lint": "npx eslint ./src",
        "pub:dev": "tsx src/publish.ts",
        "pub:build:rel": "npm run build && node dist/publish.js",
        "pub:rel": "node dist/publish.js",
        "sub:dev": "tsx watch src/subscribe.ts",
        "sub:build:rel": "npm run build && node dist/subscribe.js",
        "sub:rel": "node dist/subscribe.js",
        "cache:dev": "tsx src/cache.ts",
        "cache:build:rel": "npm run build && node dist/cache.js",
        "cache:rel": "node dist/cache.js",
        "create-product-dto-schema": "ts-json-schema-generator --path ./src/... --type ProductDto -o ./data-source/product-dto.schema.json",
        "create-data-source-schema": "ts-json-schema-generator --path ./src/data-source/... --type IDataSources -o ./data-source/data-source.schema.json"
    },
    "author": "",
    "license": "ISC",
    "description": "",
    "type": "module",
    "dependencies": {
        "ajv": "^8.17.1",
        "axios": "^1.9.0",
        "axios-retry": "^4.5.0",
        "bullmq": "^5.41.7",
        "cpx": "^1.5.0",
        "csv-parser": "^3.2.0",
        "date-fns": "^4.1.0",
        "deepmerge": "^4.3.1",
        "fast-equals": "^5.2.2",
        "fast-json-stable-stringify": "^2.1.0",
        "fast-xml-parser": "^5.2.3",
        "inversify": "^7.5.4",
        "ioredis": "^5.6.1",
        "just-diff": "^6.0.2",
        "log4js": "^6.9.1",
        "reflect-metadata": "^0.2.2",
        "sqlite3": "^5.1.7",
        "ssh2-sftp-client": "^12.0.0",
        "strip-bom-stream": "^5.0.0",
        "ts-node": "^10.9.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.26.0",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/inversify": "^2.0.32",
        "@types/ioredis": "^4.28.10",
        "@types/jest": "^30.0.0",
        "@types/log4js": "^0.0.33",
        "@types/node": "^22.15.17",
        "@types/ssh2-sftp-client": "^9.0.4",
        "eslint": "^9.26.0",
        "jest": "^30.2.0",
        "jest-mock-extended": "^4.0.0",
        "ts-jest": "^29.4.4",
        "ts-json-schema-generator": "^2.4.0",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.32.0"
    }
}
