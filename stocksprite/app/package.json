{
    "name": "stocksprite",
    "version": "1.0.0",
    "scripts": {
        "build": "npm run create-product-dto-schema && npm run create-data-source-schema && tsc",
        "build:fast": "tsc",
        "lint": "npx eslint ./src",
        "parse:dev": "tsx src/parse.ts",
        "parse:build:rel": "npm run build && node dist/parse.js",
        "parse:rel": "node dist/parse.js",
        "translate:dev": "tsx watch src/translate.ts",
        "translate:build:rel": "npm run build && node dist/translate.js",
        "translate:rel": "node dist/translate.js",
        "send:dev": "tsx watch src/send.ts",
        "send:build:rel": "npm run build && node dist/send.js",
        "send:rel": "node dist/send.js",
        "cache:dev": "tsx src/cache.ts",
        "cache:build:rel": "npm run build && node dist/cache.js",
        "cache:rel": "node dist/cache.js",
        "create-product-dto-schema": "ts-json-schema-generator --path ./src/... --type IProductDto -o ./data-source/product-dto.schema.json",
        "create-data-source-schema": "ts-json-schema-generator --path ./src/data-source/... --type IDataSources -o ./data-source/data-source.schema.json",
        "validate:dev": "tsx src/validate.ts",
        "validate:rel": "node dist/validate.js",
        "test": "vitest run",
        "test:watch": "vitest --watch"
    },
    "author": "",
    "license": "ISC",
    "description": "",
    "type": "module",
    "dependencies": {
        "@storesprite/app-config": "file:../../packages/app-config",
        "ajv": "^8.17.1",
        "axios": "^1.9.0",
        "axios-retry": "^4.5.0",
        "bullmq": "^5.41.7",
        "cpx": "^1.5.0",
        "csv-parser": "^3.2.0",
        "date-fns": "^4.1.0",
        "deepmerge": "^4.3.1",
        "fast-equals": "^5.2.2",
        "fast-json-stable-stringify": "^2.1.0",
        "fast-xml-parser": "^5.2.3",
        "inversify": "^7.5.4",
        "ioredis": "^5.6.1",
        "json-logic-js": "^2.0.5",
        "just-diff": "^6.0.2",
        "log4js": "^6.9.1",
        "reflect-metadata": "^0.2.2",
        "strip-bom-stream": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.26.0",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/inversify": "^2.0.32",
        "@types/ioredis": "^4.28.10",
        "@types/json-logic-js": "^2.0.8",
        "@types/log4js": "^0.0.33",
        "@types/node": "^22.15.17",
        "@vitest/coverage-v8": "^4.0.17",
        "eslint": "^9.26.0",
        "ts-json-schema-generator": "^2.4.0",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.32.0",
        "vitest": "^4.0.17"
    }
}
