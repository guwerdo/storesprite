{
  "$ref": "#/definitions/StockMappingItems",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "MappingRule": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          },
          "type": "object"
        }
      },
      "required": [
        "op",
        "params"
      ],
      "type": "object"
    },
    "StockMappingItem": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minLength": 1,
          "type": "string"
        },
        "rules": {
          "items": {
            "$ref": "#/definitions/MappingRule"
          },
          "type": "array"
        },
        "warehouseId": {
          "minimum": 1,
          "type": "number"
        }
      },
      "required": [
        "column",
        "warehouseId"
      ],
      "type": "object"
    },
    "StockMappingItems": {
      "items": {
        "$ref": "#/definitions/StockMappingItem"
      },
      "type": "array"
    }
  }
}