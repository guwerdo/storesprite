{
  "$ref": "#/definitions/CsvDataFormatConfig",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CsvDataFormatConfig": {
      "additionalProperties": false,
      "properties": {
        "delimiter": {
          "minLength": 1,
          "type": "string"
        },
        "encoding": {
          "type": "string"
        },
        "format": {
          "const": "CSV",
          "type": "string"
        },
        "hasHeaders": {
          "type": "boolean"
        }
      },
      "required": [
        "format",
        "delimiter"
      ],
      "type": "object"
    }
  }
}