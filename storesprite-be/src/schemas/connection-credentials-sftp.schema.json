{
  "$ref": "#/definitions/SftpCredentials",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "SftpCredentials": {
      "anyOf": [
        {
          "$ref": "#/definitions/SftpPasswordCredentials"
        },
        {
          "$ref": "#/definitions/SftpPrivateKeyCredentials"
        }
      ]
    },
    "SftpPasswordCredentials": {
      "additionalProperties": false,
      "properties": {
        "authType": {
          "const": "PASSWORD",
          "type": "string"
        },
        "password": {
          "minLength": 1,
          "type": "string"
        },
        "username": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "authType",
        "username",
        "password"
      ],
      "type": "object"
    },
    "SftpPrivateKeyCredentials": {
      "additionalProperties": false,
      "properties": {
        "authType": {
          "const": "PRIVATE_KEY",
          "type": "string"
        },
        "passphrase": {
          "type": "string"
        },
        "privateKey": {
          "minLength": 1,
          "type": "string"
        },
        "username": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "authType",
        "username",
        "privateKey"
      ],
      "type": "object"
    }
  }
}