{
  "$ref": "#/definitions/HttpCredentials",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "HttpApiKeyCredentials": {
      "additionalProperties": false,
      "properties": {
        "authType": {
          "const": "API_KEY",
          "type": "string"
        },
        "headerName": {
          "minLength": 1,
          "type": "string"
        },
        "headerValue": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "authType",
        "headerName",
        "headerValue"
      ],
      "type": "object"
    },
    "HttpBasicCredentials": {
      "additionalProperties": false,
      "properties": {
        "authType": {
          "const": "BASIC",
          "type": "string"
        },
        "password": {
          "minLength": 1,
          "type": "string"
        },
        "username": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "authType",
        "username",
        "password"
      ],
      "type": "object"
    },
    "HttpBearerCredentials": {
      "additionalProperties": false,
      "properties": {
        "authType": {
          "const": "BEARER",
          "type": "string"
        },
        "token": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "authType",
        "token"
      ],
      "type": "object"
    },
    "HttpCredentials": {
      "anyOf": [
        {
          "$ref": "#/definitions/HttpNoneCredentials"
        },
        {
          "$ref": "#/definitions/HttpBasicCredentials"
        },
        {
          "$ref": "#/definitions/HttpBearerCredentials"
        },
        {
          "$ref": "#/definitions/HttpApiKeyCredentials"
        }
      ]
    },
    "HttpNoneCredentials": {
      "additionalProperties": false,
      "properties": {
        "authType": {
          "const": "NONE",
          "type": "string"
        }
      },
      "required": [
        "authType"
      ],
      "type": "object"
    }
  }
}