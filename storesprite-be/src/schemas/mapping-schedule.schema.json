{
  "$ref": "#/definitions/MappingSchedule",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "MappingSchedule": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "date": {
              "format": "date",
              "type": "string"
            },
            "frequency": {
              "const": "once",
              "type": "string"
            },
            "time": {
              "$ref": "#/definitions/ScheduleHour"
            }
          },
          "required": [
            "frequency",
            "date",
            "time"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "daysOfWeek": {
              "items": {
                "$ref": "#/definitions/ScheduleDayOfWeek"
              },
              "type": "array",
              "uniqueItems": true
            },
            "frequency": {
              "const": "daily",
              "type": "string"
            },
            "times": {
              "items": {
                "$ref": "#/definitions/ScheduleHour"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "frequency",
            "times"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "dayOfMonth": {
              "$ref": "#/definitions/ScheduleDayOfMonth"
            },
            "frequency": {
              "const": "monthly",
              "type": "string"
            },
            "time": {
              "$ref": "#/definitions/ScheduleHour"
            }
          },
          "required": [
            "frequency",
            "dayOfMonth",
            "time"
          ],
          "type": "object"
        }
      ]
    },
    "ScheduleDayOfMonth": {
      "maximum": 31,
      "minimum": 1,
      "type": "integer"
    },
    "ScheduleDayOfWeek": {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
    },
    "ScheduleHour": {
      "maximum": 23,
      "minimum": 0,
      "type": "integer"
    }
  }
}