{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["frequency", "date", "time"],
      "properties": {
        "frequency": { "const": "once" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
        "time": { "type": "integer", "minimum": 0, "maximum": 23 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["frequency", "times"],
      "properties": {
        "frequency": { "const": "daily" },
        "times": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 23 } },
        "daysOfWeek": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 6 } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["frequency", "dayOfMonth", "time"],
      "properties": {
        "frequency": { "const": "monthly" },
        "dayOfMonth": { "type": "integer", "minimum": 1, "maximum": 31 },
        "time": { "type": "integer", "minimum": 0, "maximum": 23 }
      }
    }
  ]
}
