{
  "name": "Storesprite Backend (storesprite-be)",
  "dockerComposeFile": [
    "../../docker-compose.yaml"
  ],
  "service": "storesprite-be",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "npm install",
  "forwardPorts": [
    3000,
    5432,
    9200,
    5601
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "christian-kohler.path-intellisense"
      ]
    }
  }
}
