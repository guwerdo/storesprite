{
  "mcpServers": {
    "clerk-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.clerk.com/mcp"
      ]
    },
    "mui-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mui/mcp@latest"
      ]
    },
    "postgres-local": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://stocksprite:stocksprite_secure_pass@localhost:5432/stocksprite"
      ]
    },
    "fetch-docs": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-fetch-typescript"
      ]
    }
  }
}
